go 1.25.0

// The modules in the repository are developed together: go build ./... / go test ./... from the
// root directory reaches across them.
// Note that inside a workspace go list -m all merges every module's dependencies together, so
// checking the core's dependency footprint requires GOWORK=off.
use (
	.
	./e2e
	./example
	./internal/schemagen
	./xbeego
	./xcache
	./xcron
	./xkafka
	./xecho
	./xgin
	./xginswagger
	./xgorm
	./xgorm/clickhouse
	./xhttp
	./xmetric
	./xredis
	./xtrace
)
