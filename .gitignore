# go.work is checked in: this is a multi-module repository, and the modules point at
# each other with replace. Without it everybody has to assemble one by hand, an IDE opened
# on the root directory knows only the root module, and the go run ./example in
# docs/development.md is a fiction.
# Note that scripts/check.sh / scripts/test.sh always run module by module with GOWORK=off --
# a workspace hides a problem in a module's own go.mod, and that is exactly what CI must catch.

# Build artifacts
/bin/
*.out

# go build puts the binary in the package directory by default, named after the directory.
# example/example (36.9 MB) was committed once by accident, so executables with no extension
# are blocked here
/example/example
/example/consumer/consumer
# go build ./internal/schemagen produces this one in the root directory, likewise committed once
# by accident (3.4 MB)
/schemagen

# Only CLAUDE.md and skills/ are checked in under .claude/; worktree copies and local settings
# stay out of the repository
/.claude/worktrees/
/.claude/settings.local.json

# The output of e2e in CI (tee e2e.log). Unblocked it makes the working tree dirty, and
# release.sh then refuses to tag
/e2e.log

# Python bytecode cache (produced when scripts/mutate.py imports scripts/mutations/)
__pycache__/

# IDE
.idea/
.vscode/
.DS_Store
